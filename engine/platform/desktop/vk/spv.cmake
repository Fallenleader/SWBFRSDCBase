# Compile the Vulkan back end's GLSL to SPIR-V (glslangValidator) and write gfx_vk_spv.h: one `static const uint32_t spv_<name>[]`
cmake_policy(SET CMP0007 NEW)
# per program.   cmake -DSRC=<this dir> -DOUT=<header> -DGLSLANG=<glslangValidator> -P spv.cmake
set(progs "ak_vert|ak.vert|-DVS" "opaque_frag|ak.frag|-DOPAQUE" "cutout_frag|ak.frag|-DCUTOUT" "alpha_frag|ak.frag|-DALPHA"
          "beam_frag|ak.frag|-DBEAM" "ui_vert|ui.vert|-DVS" "ui_frag|ui.frag|-DFS")
set(text "/* generated by platform/desktop/vk/spv.cmake - do not edit */\n#include <stdint.h>\n")
foreach(p ${progs})
  string(REPLACE "|" ";" f "${p}")
  list(GET f 0 name)
  list(GET f 1 src)
  list(GET f 2 def)
  set(tmp "${OUT}.${name}.spv")
  if(def)
    execute_process(COMMAND ${GLSLANG} -V --target-env vulkan1.1 ${def} ${SRC}/${src} -o ${tmp} RESULT_VARIABLE r OUTPUT_VARIABLE o ERROR_VARIABLE e)
  else()
    execute_process(COMMAND ${GLSLANG} -V --target-env vulkan1.1 ${SRC}/${src} -o ${tmp} RESULT_VARIABLE r OUTPUT_VARIABLE o ERROR_VARIABLE e)
  endif()
  if(r)
    message(FATAL_ERROR "shader ${name}: ${o}${e}")
  endif()
  file(READ ${tmp} hex HEX)
  string(LENGTH "${hex}" n)
  set(words "")
  set(i 0)
  while(i LESS n)
    string(SUBSTRING "${hex}" ${i} 8 w)
    string(SUBSTRING "${w}" 6 2 b3)
    string(SUBSTRING "${w}" 4 2 b2)
    string(SUBSTRING "${w}" 2 2 b1)
    string(SUBSTRING "${w}" 0 2 b0)
    string(APPEND words "0x${b3}${b2}${b1}${b0},")
    math(EXPR i "${i} + 8")
  endwhile()
  string(APPEND text "static const uint32_t spv_${name}[] = {${words}};\n")
  file(REMOVE ${tmp})
endforeach()
file(WRITE ${OUT} "${text}")
